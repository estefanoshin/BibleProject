# When true, BibleAPI reads books/chapters/verses from resources/*.csv instead of SQL Server.
OFFLINE=true

MSSQL_HOST=localhost
MSSQL_PORT=1435
MSSQL_USER=sa
MSSQL_SA_PASSWORD=BibleDev1!
MSSQL_DATABASE=master
MSSQL_CONTAINER_NAME=BibleDatabase

# Base URL the packaged mobile apps use to reach BibleAPI.
# The Android emulator is a separate machine: localhost points at the emulator
# itself, and 10.0.2.2 is the alias for the host running Docker.
# For a physical device use this machine's LAN IP, e.g. http://192.168.1.20:5010
ANDROID_API_URL=http://192.168.1.10:5010
IOS_API_URL=http://localhost:5010
